#!/bin/sh
# Verify that src/croaring/ is the CRoaring release pinned in vendor.yaml
# plus exactly the patch series it lists, byte for byte. Exits non-zero on
# any difference. Run from the package root.
#
#   tools/verify-vendor            the gate
#   tools/verify-vendor --canary   re-derive with the first patch left out
#                                  and require verification to FAIL
#   tools/verify-vendor --write    re-derive and write src/croaring/ (for
#                                  an upstream bump; see vendor.yaml)
set -eu

MODE=verify
case "${1:-}" in
  --canary) MODE=canary ;;
  --write) MODE=write ;;
  "") ;;
  *) echo "usage: tools/verify-vendor [--canary | --write]" >&2; exit 2 ;;
esac

MANIFEST=vendor.yaml
DEST=src/croaring
[ -f "$MANIFEST" ] || { echo "missing $MANIFEST; run from the package root" >&2; exit 1; }

field() { awk -v k="$1" '$1 == k":" {print $2; exit}' "$MANIFEST"; }
REPO=$(field upstream)
TAG=$(field tag)
COMMIT=$(field commit)

if command -v sha256sum >/dev/null 2>&1; then
  sha256() { sha256sum "$1" | cut -d' ' -f1; }
else
  sha256() { shasum -a 256 "$1" | cut -d' ' -f1; }
fi

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
TREE="$WORK/tree"
mkdir "$TREE"
FAILURES="$WORK/failures"
: > "$FAILURES"

# "name from sha256" for each pinned file.
awk '
  /^  files:/ {on = 1; next}
  on && /^  [^ ]/ {on = 0}
  on && /^    [^ ].*:$/ {name = $1; sub(/:$/, "", name)}
  on && $1 == "from:" {from = $2}
  on && $1 == "sha256:" {print name, from, $2}
' "$MANIFEST" > "$WORK/files"

echo "==> CRoaring $TAG ($COMMIT)"
while read -r name from want; do
  case "$from" in
    release) url="https://github.com/$REPO/releases/download/$TAG/$name" ;;
    commit) url="https://raw.githubusercontent.com/$REPO/$COMMIT/$name" ;;
    *) echo "FAIL: $name has unknown source '$from'" >&2; exit 1 ;;
  esac
  # --retry, because this runs on every push. Integrity rests on the
  # SHA-256 comparison, not on the transport.
  curl -fsSL --retry 3 --retry-delay 2 --retry-connrefused -o "$TREE/$name" "$url"
  got=$(sha256 "$TREE/$name")
  if [ "$got" != "$want" ]; then
    echo "FAIL: $name sha256 mismatch" >&2
    echo "  expected $want" >&2
    echo "  actual   $got" >&2
    exit 1
  fi
  echo "    $name sha256 ok"
done < "$WORK/files"

# The patch series must be exactly what the manifest lists, in order.
awk '
  /^  patches:/ {on = 1; next}
  on && /^  [^ ]/ {on = 0}
  on && $1 == "-" {print $2}
' "$MANIFEST" > "$WORK/listed"
(ls tools/patches/*.patch 2>/dev/null || true) | xargs -n1 basename 2>/dev/null > "$WORK/present" || true
if ! cmp -s "$WORK/listed" "$WORK/present"; then
  echo "FAIL: tools/patches/ does not match the patch list in $MANIFEST" >> "$FAILURES"
fi

first=1
while read -r p; do
  if [ "$MODE" = canary ] && [ "$first" -eq 1 ]; then
    echo "==> canary: leaving out $p"
    first=0
    continue
  fi
  first=0
  patch -s -p1 -d "$TREE" < "tools/patches/$p" ||
    echo "FAIL: tools/patches/$p does not apply cleanly" >> "$FAILURES"
  echo "    applied $p"
done < "$WORK/listed"
find "$TREE" \( -name '*.orig' -o -name '*.rej' \) -exec rm -f {} +

if [ "$MODE" = write ]; then
  [ -s "$FAILURES" ] && { cat "$FAILURES" >&2; exit 1; }
  mkdir -p "$DEST"
  cp "$TREE"/* "$DEST"/
  echo "==> wrote $DEST"
  exit 0
fi

# Every derived file must match, and src/croaring/ may hold nothing else
# apart from build artefacts.
for f in "$TREE"/*; do
  b=$(basename "$f")
  if [ ! -f "$DEST/$b" ]; then
    echo "FAIL: $DEST/$b is missing" >> "$FAILURES"
  elif ! cmp -s "$f" "$DEST/$b"; then
    echo "FAIL: $DEST/$b differs from upstream plus patches" >> "$FAILURES"
  fi
done
for f in "$DEST"/*; do
  b=$(basename "$f")
  case "$b" in *.o | *.so | *.dll | *.dylib) continue ;; esac
  [ -f "$TREE/$b" ] || echo "FAIL: $DEST/$b is not derived from upstream" >> "$FAILURES"
done

if [ "$MODE" = canary ]; then
  if [ -s "$FAILURES" ]; then
    echo "==> canary ok: verification fails without the first patch"
    exit 0
  fi
  echo "FAIL: canary: verification passed with a patch left out" >&2
  exit 1
fi

if [ -s "$FAILURES" ]; then
  cat "$FAILURES" >&2
  exit 1
fi
echo "==> $DEST is CRoaring $TAG plus $(wc -l < "$WORK/listed" | tr -d ' ') patch(es)"
